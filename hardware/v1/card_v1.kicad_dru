(version 1)
# JLC 2-layer limits everywhere except the U1 (BQ51003 DSBGA) via-in-pad, which needs JLC 4-layer
# BGA capability (0.15 drill / 0.25 copper). See docs/QUESTIONS_FOR_DWAYNE.md item 0.
(rule "jlc_2layer_via"
  (condition "A.Type == 'Via' && !A.intersectsCourtyard('U1') && A.Net != 'DECA'")
  (constraint hole_size (min 0.25mm))
  (constraint via_diameter (min 0.5mm))
  (constraint annular_width (min 0.125mm)))
(rule "rf_gcpw_gap"
  (condition "A.NetClass == 'RF50' && B.Net == 'GND'")
  (constraint clearance (min 0.15mm)))
(rule "u1_via_in_pad_hole_clearance"
  (condition "A.intersectsCourtyard('U1')")
  (constraint hole_clearance (min 0.15mm)))
(rule "thermal_spokes"
  (constraint min_resolved_spokes (min 1)))
