				(thickness 0.0994)
				(material "3313")
				(epsilon_r 4.1)
				(loss_tangent 0.02)
			)
			(layer "In1.Cu"
				(type "copper")
				(thickness 0.0152)
			)
			(layer "dielectric 2"
				(type "core")
